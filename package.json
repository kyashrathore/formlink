{
  "name": "formlink",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run type-check",
    "dev:fill": "turbo run dev --filter=@formlink/formfiller",
    "dev:craft": "turbo run dev --filter=formcraft",
    "dev:all": "turbo run dev --parallel --filter=@formlink/formfiller --filter=formcraft",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "type-check": "turbo run type-check",
    "quality-check": "./scripts/quality-check.sh",
    "prepare": "husky install",
    "storybook": "pnpm --filter ui-docs storybook",
    "db:hard-reset": "pnpm -C packages/db dlx supabase stop --project-id formcraft || true && pnpm -C packages/db dlx supabase start --workdir ./supabase && pnpm -C packages/db dlx supabase db reset --local --yes --workdir ./supabase && PGPASSWORD=postgres psql -v ON_ERROR_STOP=1 -h 127.0.0.1 -p 54322 -U postgres -d postgres -f packages/db/supabase/schema.sql && PGPASSWORD=postgres psql -h 127.0.0.1 -p 54322 -U postgres -d postgres -c \"NOTIFY pgrst, 'reload schema';\" || true",
    "db:gen-types": "pnpm -C packages/db dlx supabase gen types typescript --local --workdir ./supabase > packages/db/src/types/database.types.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@formlink/eslint-config": "workspace:*",
    "@formlink/typescript-config": "workspace:*",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.2",
    "@types/hast": "^3.0.4",
    "husky": "^9.1.7",
    "knip": "^5.63.0",
    "lint-staged": "^15.2.11",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "turbo": "^2.5.2",
    "zod": "^3.25.0"
  },
  "lint-staged": {
    "*.{ts,tsx,json,md,yml,yaml}": [
      "npx prettier --write"
    ]
  },
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.1.11",
      "@types/react-dom": "^19.1.7"
    }
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "fast-xml-parser": "^4.5.3",
    "framer-motion": "^10.18.0",
    "libphonenumber-js": "^1.12.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.5",
    "usesend-js": "^1.5.2"
  }
}
