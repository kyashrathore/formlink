{
  "extends": "@formlink/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@formlink/prompts": ["../../packages/prompts/src"],
      "@formlink/runtime": ["../../packages/runtime/dist/index.d.ts"],
      "@formlink/runtime/*": ["../../packages/runtime/dist/*"],
      "@formlink/runtime/ui/react": [
        "../../packages/runtime/dist/ui/react/index.d.ts"
      ],
      "@formlink/ui/components/*": ["../../packages/ui/src/components/*"],
      "@formlink/ui/lib/*": ["../../packages/ui/src/lib/*"],
      "@formlink/ui/hooks/*": ["../../packages/ui/src/hooks/*"],
      "@formlink/ui/*": [
        "../../packages/ui/src/components/ui/*",
        "../../packages/ui/src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/test/**/*",
    "**/tests/**/*",
    "**/__tests__/**/*"
  ]
}
