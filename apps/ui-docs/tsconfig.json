{
  "extends": "../../packages/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "types": ["react", "react-dom"],
    "paths": {
      "@/*": ["../../packages/ui/src/*", "../../packages/runtime/src/*"],
      "@formlink/runtime": ["../../packages/runtime/src/index.ts"],
      "@formlink/runtime/ui/react": [
        "../../packages/runtime/src/ui/react/index.ts"
      ],
      "@formlink/runtime/*": ["../../packages/runtime/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".storybook/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
