{
  "name": "@formlink/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc",
    "test": "tsc && node test/e2e.mjs",
    "db:migrate:local": "wrangler d1 migrations apply formlink --local",
    "db:migrate": "wrangler d1 migrations apply formlink --remote",
    "test:e2e": "node test/e2e.mjs",
    "test:external": "node test/external.mjs",
    "test:browser": "node test/browser.mjs && node test/mcp-app.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261018.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}